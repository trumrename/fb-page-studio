; Custom NSIS bits for FB Page Studio
; Same appId → cài đè bản cũ (Start Menu / Windows Search giữ 1 shortcut)

!macro customInstall
  ; Desktop + Start Menu already created by electron-builder flags
  ; Icon: build/icon.ico → hiển thị trong Start Menu / tìm kiếm Windows
!macroend

!macro customUnInstall
!macroend
