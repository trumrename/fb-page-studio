# =============================================
# Máy KHÁCH — EXE / Setup + OAuth relay HTTPS
# Ảnh local. KHÔNG Ngrok. KHÔNG App Secret trên máy này.
# =============================================

PORT=3847
# UI local (không phải redirect Facebook)
APP_BASE_URL=http://127.0.0.1:3847

# Bật relay: Connect FB qua domain HTTPS
OAUTH_RELAY=1
NGROK_AUTOSTART=0
NGROK_AUTHTOKEN=

# Domain relay (trùng Valid OAuth Redirect URIs trên Meta)
OAUTH_RELAY_URL=https://modelswiki.top
FB_REDIRECT_URI=https://modelswiki.top/auth/facebook/callback

# ĐỂ TRỐNG — tự điền App ID trong tool (Cấu hình lần đầu).
FB_APP_ID=
# FB_APP_SECRET=   ← để trống; secret chỉ trên server oauth-relay
FB_APP_NAME=App 1
FB_GRAPH_VERSION=v21.0
FB_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,pages_manage_engagement,read_insights,public_profile

TOKEN_ENCRYPTION_KEY=

GITHUB_REPO=trumrename/fb-page-studio
UPDATE_ASSET=FB-Page-Studio-Desktop.exe
